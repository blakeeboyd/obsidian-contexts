{
  "name": "obsidian-episodic",
  "version": "0.1.0",
  "description": "Memory for your vault: records your actions in Obsidian to see the evolution of thought in your vault.",
  "main": "main.js",
  "scripts": {
    "dev": "EPISODIC_VAULT=\"$HOME/Documents/Obsidian/EtchedInterim\" node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "EPISODIC_VAULT=\"$HOME/Documents/Obsidian/EtchedInterim\" node esbuild.config.mjs production",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Blake Boyd",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  }
}
